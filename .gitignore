.opencode
# Anchored: a bare "data" would also ignore src/data/ (the dataloader
# package), breaking fresh clones with ModuleNotFoundError: src.data
/data/
/references/

checkpoints/cumulative_ablation

# Python
.pytest_cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Data & artifacts
data/*.csv
checkpoints/*.pt
checkpoints/*.json
*.png
!docs/**/*.png

# Case-study recordings (large .npy dumps, regenerated by
# scripts/case_study/run_case_study.sh)
output/case_study/record_*/

checkpoints/hyperparam/
checkpoints/robustness/

# Experiment runner logs (scripts/hyperparam/launch_sensitivity.sh et al.)
log/

# Optuna HPO artifacts (databases, GPU-budget state; curated exports may be
# committed explicitly) -- see assets/optuna.md
output/hpo/**/*.db
output/hpo/gpu_budget*.json
output/hpo/gpu_budget.lock
output/hpo/csv/

# Notebooks / IDE
.ipynb_checkpoints/
.idea/
.vscode/
.DS_Store

# PyTorch / CUDA caches
*.pth
.torch_compile_cache/

# Raw datasets (downloaded, not versioned)
data/*.csv
data/*.txt
data/*.gz

# LaTeX build artifacts (main.pdf is intentionally tracked)
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.log
paper/**/*.spl
paper/**/*.out
paper/**/*.toc

# Stray LaTeX artifacts from a run outside paper/ (e.g. wrong cwd)
texput.log
*.synctex.gz
